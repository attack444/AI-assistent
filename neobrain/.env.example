# =============================================================================
#  NeoBrain — пример переменных окружения.
#  ЧТО ДЕЛАТЬ: скопируй этот файл в `.env` (`cp .env.example .env`) и подставь
#  свои значения. Файл `.env` в git НЕ коммитим (см. .gitignore).
# =============================================================================

# --- Общий домен верхнего уровня для SSO-куки -------------------------------
# Куки сессии ставится на ".neobrain.local", поэтому она видна и на
# neobrain.local, и на 5mb2.local (единый вход между доменами).
# В проде поставь общий родительский домен, напр. ".neobrain.app"
# (если оба сайта — поддомены) ИЛИ используй схему с редиректом (см. README).
COOKIE_DOMAIN=.neobrain.local
SESSION_SECRET=change-me-please-32-chars-minimum-secret

# --- База данных PostgreSQL (общая для обоих сайтов) ------------------------
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL=postgresql://neobrain:neobrain@postgres:5432/neobrain?schema=public

# --- Redis (кэш, rate-limit, очереди, сессии) ------------------------------
REDIS_URL=redis://redis:6379

# --- LLM-gateway ------------------------------------------------------------
# Внутренний адрес шлюза моделей (web и worker ходят сюда).
LLM_GATEWAY_URL=http://llm-gateway:8090
# Ключи провайдеров. Если пусто — используется MOCK-провайдер (для локальной
# разработки без денег): он возвращает предсказуемый ответ и считает токены.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Экономика токенов ------------------------------------------------------
# Курс USD->RUB для перевода стоимости моделей в рубли (модели считаются в USD).
USD_RUB_RATE=95
# Наша наценка (маржа) поверх себестоимости токенов. 1.5 = +50%.
PRICE_MARKUP=1.5

# --- Порты (внутри docker-сети) --------------------------------------------
WEB_PORT=8080
GATEWAY_PORT=8090

# --- Прочее -----------------------------------------------------------------
NODE_ENV=development
