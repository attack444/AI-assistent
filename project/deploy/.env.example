# ============================================================
#  AI Helper — переменные окружения
#  Скопируй этот файл в project/.env и заполни
# ============================================================

# ── AI Модели ────────────────────────────────────────────────

# ── Бесплатная модель на сервере (Ollama) ─────────────────────
# Установка: bash project/deploy/install-free-llm.sh
# 1.5b = чат/обзор. Правки файлов (tools) — только через DeepSeek или модель ≥7b.
OLLAMA_HOST=http://ollama:11434
FREE_LLM_MODEL=qwen2.5:1.5b
FAST_LLM_MODEL=qwen2.5:1.5b
# 1 = сначала бесплатная Ollama (чат), потом DeepSeek (правки)
LLM_PREFER_FREE=1
# 0 = никогда не слать tools в Ollama; 1 = принудительно (даже для 1.5b — обычно ломается)
# FREE_LLM_TOOLS=0

# DeepSeek — РЕКОМЕНДУЕМ для панели/VS Code (правки сайтов, WP, код)
# Регистрация: https://platform.deepseek.com  (~$0.14 / 1M tokens input)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq (часто недоступен из РФ без VPN/прокси) — запасной путь
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_HELPER_HTTP_PROXY=
HTTPS_PROXY=

# ── Основная локальная модель (если нет DeepSeek) ─
LLM_MODEL=qwen2.5:1.5b

# ── База данных ───────────────────────────────────────────────
POSTGRES_DB=aihelper
POSTGRES_USER=aihelper
# Пусто → setup/update сгенерируют через ensure-secrets.sh
POSTGRES_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Секреты ───────────────────────────────────────────────────
# Пустые значения заполняет: bash deploy/ensure-secrets.sh project/.env
# openssl rand -hex 24  — если задаёшь вручную
SECRET_KEY=

# Пароль входа в панель (файлы / сайты / чат). Не оставляй пустым на VPS!
PANEL_PASSWORD=

# 0 = fail-closed (прод). 1 = открытая панель без пароля (только local/dev)
ALLOW_OPEN_PANEL=0

# ── Настройки сервера ────────────────────────────────────────
API_PORT=8502
CHAT_PORT=8501
PANEL_PORT=3000
ALLOWED_ORIGINS=*

# Папка сайтов внутри контейнера (на хосте: /var/ai-helper/sites)
SITES_ROOT=/opt/sites
WORKSPACE_ROOTS=/opt/sites,/opt/ai-helper,/workspace

# MYSQL для WordPress — ТОЛЬКО латиница/цифры в паролях!
# Пусто → ensure-secrets.sh сгенерирует. Не публикуется наружу (только docker-сеть).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=

# Лимит загрузки (байты), по умолчанию 2 ГБ
MAX_UPLOAD_BYTES=2147483648

# ── Владелец (без ограничений на публичной витрине) ───────────
OWNER_EMAIL=slavasundukov887@gmail.com

# ── Публичная витрина AI (чат/деплой) ─────────────────────────
# 1 = нужен логин пользователя; 0 = анонимно (не рекомендуем)
PUBLIC_AUTH_REQUIRED=1
# 1 = виджет на клиентских сайтах (5mb2) отвечает гостям без логина
PUBLIC_WIDGET_GUEST=1
PUBLIC_WIDGET_RATE_LIMIT=20
# Витрина по-прежнему требует логин для деплоя; виджет на 5mb2 — гость
# Тариф по умолчанию для новых юзеров: free | starter | pro
PUBLIC_DEFAULT_PLAN=free
