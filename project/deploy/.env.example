# ============================================================
#  AI Helper — переменные окружения
#  Скопируй этот файл в project/.env и заполни
# ============================================================

# ── AI Модели ────────────────────────────────────────────────

# ── Бесплатная модель на сервере (Ollama) ─────────────────────
# Установка: bash project/deploy/install-free-llm.sh
OLLAMA_HOST=http://ollama:11434
FREE_LLM_MODEL=qwen2.5:1.5b
FAST_LLM_MODEL=qwen2.5:1.5b
# 1 = сначала бесплатная Ollama, потом DeepSeek
LLM_PREFER_FREE=1

# DeepSeek — платный/дешёвый облачный fallback
# Регистрация: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq (часто недоступен из РФ без VPN/прокси)
GROQ_API_KEY=
AI_HELPER_HTTP_PROXY=
HTTPS_PROXY=

# ── Основная модель (для агента с tools; при FREE — = FREE_LLM_MODEL) ─
LLM_MODEL=qwen2.5:1.5b

# ── База данных ───────────────────────────────────────────────
POSTGRES_DB=aihelper
POSTGRES_USER=aihelper
POSTGRES_PASSWORD=change_me_postgres_123

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Секреты ───────────────────────────────────────────────────
# Случайная строка для JWT. Сгенерируй: openssl rand -hex 32
# Только латиница/цифры (без кириллицы)!
SECRET_KEY=change_me_to_random_string_min_32_chars

# Пароль входа в панель (файлы / сайты / чат). ОБЯЗАТЕЛЬНО смени!
# Можно кириллицу — но латиница проще.
PANEL_PASSWORD=change_me_panel_password

# ── Настройки сервера ────────────────────────────────────────
API_PORT=8502
CHAT_PORT=8501
PANEL_PORT=3000
ALLOWED_ORIGINS=*

# Папка сайтов внутри контейнера (на хосте: /var/ai-helper/sites)
SITES_ROOT=/opt/sites
WORKSPACE_ROOTS=/opt/sites,/opt/ai-helper,/workspace

# MYSQL для WordPress — ТОЛЬКО латиница/цифры в паролях!
# (pymysql/MySQL client ломаются на кириллических паролях)
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=wp_change_me

# Лимит загрузки (байты), по умолчанию 2 ГБ
MAX_UPLOAD_BYTES=2147483648

# ── Владелец (без ограничений на публичной витрине) ───────────
OWNER_EMAIL=slavasundukov887@gmail.com

# ── Публичная витрина AI (чат/деплой) ─────────────────────────
# 1 = нужен логин пользователя; 0 = анонимно (не рекомендуем)
PUBLIC_AUTH_REQUIRED=1
# Тариф по умолчанию для новых юзеров: free | starter | pro
PUBLIC_DEFAULT_PLAN=free
