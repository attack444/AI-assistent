# ============================================================
#  AI Helper — переменные окружения
#  Скопируй этот файл в project/.env и заполни
# ============================================================

# ── AI Модели ────────────────────────────────────────────────

# DeepSeek (рекомендуется для кода — бесплатно 10M токенов при регистрации)
# Регистрация: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq (бесплатно, быстро)
# Регистрация: https://console.groq.com
GROQ_API_KEY=

# Ollama (если хочешь запустить локально на VPS — нужен GPU)
OLLAMA_HOST=http://localhost:11434

# ── Основная модель ───────────────────────────────────────────
# Варианты: deepseek-coder (отличный), llama-3.3-70b-versatile (Groq)
LLM_MODEL=deepseek-coder

# ── База данных ───────────────────────────────────────────────
POSTGRES_DB=aihelper
POSTGRES_USER=aihelper
POSTGRES_PASSWORD=сменитепароль123_ОБЯЗАТЕЛЬНО

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Секреты ───────────────────────────────────────────────────
# Случайная строка для JWT. Сгенерируй: openssl rand -hex 32
SECRET_KEY=замени_на_случайную_строку_минимум_32_символа

# ── Настройки сервера ────────────────────────────────────────
API_PORT=8502
CHAT_PORT=8501
ALLOWED_ORIGINS=*

# ── Владелец (без ограничений) ────────────────────────────────
OWNER_EMAIL=твой@email.com
