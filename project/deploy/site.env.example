# Скопируй в /opt/ai-helper/project/deploy/site.env и заполни.
# Потом: bash /opt/ai-helper/project/deploy/finish-site.sh
# Не коммить этот файл с реальными паролями.

# Имя папки сайта в панели (латиница): mysite / 5mb2 / …
SITE_NAME=mysite

# Домен (без https://)
DOMAIN=5mb2.ru

# Старый URL из WordPress на старом хостинге (как в Настройки → Общие)
# Примеры: https://5mb2.ru  |  http://5mb2.ru  |  https://www.5mb2.ru
OLD_URL=https://5mb2.ru

# Новый URL после переноса (обычно https://ДОМЕН)
NEW_URL=https://5mb2.ru

# Путь к SQL-дампу УЖЕ на VPS (после scp), или оставь пустым и лей через панель
# Пример: /tmp/dump.sql
SQL_FILE=

# MySQL (латиница!). Если пусто — скрипт возьмёт из project/.env или создаст
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SSL Let's Encrypt (1 = да, 0 = нет). Нужен DNS A → IP VPS
ENABLE_SSL=1

# Email для Let's Encrypt (обязателен при SSL)
SSL_EMAIL=you@example.com
