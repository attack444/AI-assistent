{
  "name": "ai-helper",
  "displayName": "AI Helper",
  "description": "AI на VPS: чат правит сайт на сервере, сохранение файла сразу на сайт",
  "version": "1.2.0",
  "publisher": "ai-helper-local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "repository": { "type": "git", "url": "https://github.com/attack444/AI-assistent" },
  "license": "MIT",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiHelperPanel",
          "title": "AI Helper",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "aiHelperPanel": [
        {
          "type": "webview",
          "id": "aiHelper.chat",
          "name": "Чат → сайт"
        }
      ]
    },
    "commands": [
      { "command": "aiHelper.newChat", "title": "AI Helper: Новый чат" },
      { "command": "aiHelper.selectSite", "title": "AI Helper: Выбрать сайт на VPS" },
      { "command": "aiHelper.pushFile", "title": "AI Helper: Отправить файл на сайт" },
      { "command": "aiHelper.toggleAutoSync", "title": "AI Helper: Авто-синк при сохранении" },
      { "command": "aiHelper.smartCommit", "title": "AI Helper: Smart Commit" },
      { "command": "aiHelper.smartCommitPush", "title": "AI Helper: Smart Commit + Push" },
      { "command": "aiHelper.applyLastCode", "title": "AI Helper: Применить последний код" }
    ],
    "menus": {
      "editor/context": [
        { "command": "aiHelper.pushFile", "group": "aiHelper@1" }
      ],
      "scm/title": [
        { "command": "aiHelper.smartCommit", "group": "aiHelper@1" },
        { "command": "aiHelper.smartCommitPush", "group": "aiHelper@2" }
      ]
    },
    "keybindings": [
      { "command": "aiHelper.newChat", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "aiHelper.pushFile", "key": "ctrl+alt+s", "mac": "cmd+alt+s" },
      { "command": "aiHelper.smartCommit", "key": "ctrl+alt+c", "mac": "cmd+alt+c" }
    ],
    "configuration": {
      "title": "AI Helper",
      "properties": {
        "aiHelper.apiUrl": {
          "type": "string",
          "default": "http://80.78.248.195/api",
          "description": "URL API панели на VPS (через nginx /api или :8502)"
        },
        "aiHelper.chatUrl": {
          "type": "string",
          "default": "http://80.78.248.195",
          "description": "URL веб-панели"
        },
        "aiHelper.token": {
          "type": "string",
          "default": "",
          "description": "Bearer-токен панели (после входа в веб-панель — из localStorage ai-helper-token, или логин командой)"
        },
        "aiHelper.password": {
          "type": "string",
          "default": "",
          "description": "Пароль панели (PANEL_PASSWORD). Если задан — токен получается автоматически"
        },
        "aiHelper.site": {
          "type": "string",
          "default": "",
          "description": "Имя сайта на сервере (папка в /var/ai-helper/sites), например 5mb2"
        },
        "aiHelper.autoSyncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "При сохранении файла в VS Code сразу писать его на сайт (POST /sites/sync)"
        },
        "aiHelper.localRoot": {
          "type": "string",
          "default": "",
          "description": "Локальная папка-зеркало сайта (пусто = корень workspace). Относительные пути от неё → путь на сайте"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.19.0"
  }
}
