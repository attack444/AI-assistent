{
  "name": "ai-helper",
  "displayName": "AI Helper",
  "description": "AI на VPS: чат и Ctrl+S правят сайт на сервере",
  "version": "1.3.2",
  "publisher": "ai-helper-local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "repository": { "type": "git", "url": "https://github.com/attack444/AI-assistent" },
  "license": "MIT",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiHelperPanel",
          "title": "AI Helper",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "aiHelperPanel": [
        {
          "type": "webview",
          "id": "aiHelper.chat",
          "name": "Чат → сайт"
        }
      ]
    },
    "commands": [
      { "command": "aiHelper.setup", "title": "AI Helper: Настройка VPS (пароль, сайт, авто-синк)" },
      { "command": "aiHelper.newChat", "title": "AI Helper: Новый чат" },
      { "command": "aiHelper.selectSite", "title": "AI Helper: Выбрать сайт на VPS" },
      { "command": "aiHelper.pushFile", "title": "AI Helper: Отправить файл на сайт" },
      { "command": "aiHelper.toggleAutoSync", "title": "AI Helper: Авто-синк при сохранении" },
      { "command": "aiHelper.smartCommit", "title": "AI Helper: Smart Commit" },
      { "command": "aiHelper.smartCommitPush", "title": "AI Helper: Smart Commit + Push" },
      { "command": "aiHelper.applyLastCode", "title": "AI Helper: Применить последний код" }
    ],
    "menus": {
      "editor/context": [
        { "command": "aiHelper.pushFile", "group": "aiHelper@1" }
      ],
      "scm/title": [
        { "command": "aiHelper.smartCommit", "group": "aiHelper@1" },
        { "command": "aiHelper.smartCommitPush", "group": "aiHelper@2" }
      ]
    },
    "keybindings": [
      { "command": "aiHelper.setup", "key": "ctrl+alt+h", "mac": "cmd+alt+h" },
      { "command": "aiHelper.newChat", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "aiHelper.pushFile", "key": "ctrl+alt+s", "mac": "cmd+alt+s" },
      { "command": "aiHelper.smartCommit", "key": "ctrl+alt+c", "mac": "cmd+alt+c" }
    ],
    "configuration": {
      "title": "AI Helper",
      "properties": {
        "aiHelper.password": {
          "type": "string",
          "default": "",
          "order": 1,
          "description": "Пароль панели на VPS (PANEL_PASSWORD). Нужен для записи на сайт."
        },
        "aiHelper.site": {
          "type": "string",
          "default": "",
          "order": 2,
          "description": "Имя сайта на сервере, например 5mb2"
        },
        "aiHelper.autoSyncOnSave": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "Ctrl+S сразу пишет файл на сайт (POST /sites/sync)"
        },
        "aiHelper.apiUrl": {
          "type": "string",
          "default": "http://80.78.248.195/api",
          "order": 4,
          "description": "URL API панели (обычно http://IP/api)"
        },
        "aiHelper.chatUrl": {
          "type": "string",
          "default": "http://80.78.248.195",
          "order": 5,
          "description": "URL веб-панели в браузере"
        },
        "aiHelper.token": {
          "type": "string",
          "default": "",
          "order": 6,
          "description": "Bearer-токен (необязательно, если задан Password)"
        },
        "aiHelper.localRoot": {
          "type": "string",
          "default": "",
          "order": 7,
          "description": "Локальная папка-зеркало сайта (пусто = корень workspace)"
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.19.0"
  }
}
